# Copy this file to .env in the project root before running docker compose.

POSTGRES_USER=faceadmin
POSTGRES_PASSWORD=CHANGE_ME_long_postgres_password
REDIS_PASSWORD=CHANGE_ME_long_redis_password

# Public HTTP port for the application.
FRONTEND_PORT=80

# Optional storage checks used by /ready.
MEDIA_MIN_FREE_GB=2
MEDIA_MAX_GB=0

# Keep disabled in production unless Swagger is intentionally needed.
ENABLE_API_DOCS=0
