# ============================================================
# GSC Face Analytics Pro — ENV EXAMPLE
# Copy to .env and fill in your values
# ============================================================

# JWT — generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_generate_a_random_64_char_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
LOG_LEVEL=INFO
# Set LOG_JSON=1 in production for structured JSON logging (ELK, Datadog, CloudWatch)
LOG_JSON=0

# APP_ENV=development enables Swagger docs at /docs automatically
APP_ENV=production

# Cookie security (set COOKIE_SECURE=1 when serving over HTTPS)
COOKIE_SECURE=0
COOKIE_SAMESITE=lax
# Optional separate CSRF signing secret. SECRET_KEY is used when omitted.
CSRF_SECRET=
# Enabled by default in production. Bearer-authenticated API requests are exempt.
ENABLE_CSRF=1
# Set ENABLE_API_DOCS=1 to enable Swagger UI at /docs (auto-enabled when APP_ENV=development)
ENABLE_API_DOCS=0

# Global API rate limit: max requests per minute per IP (default 200)
GLOBAL_RATE_LIMIT=200
# Alarm endpoint: set ALARM_OPEN_ACCESS=1 only in dev/trusted-LAN environments
ALARM_OPEN_ACCESS=0
MEDIA_URL_TTL_SECONDS=900

# Offline module licensing is enabled by default. Use 0 only for local development.
LICENSE_ENFORCEMENT=1
LICENSE_PUBLIC_KEY_FILE=license_public_key.pem
LICENSE_FILE=runtime/license.json
LICENSE_INSTALLATION_ID_FILE=runtime/installation_id
LICENSE_SERVER_URL=https://licenses.example.com
LICENSE_SERVER_TIMEOUT_SECONDS=15
# Allow plain HTTP only for a localhost development activation server.
LICENSE_SERVER_ALLOW_HTTP=0

# First-run admin password (only used if no admin exists in DB)
DEFAULT_ADMIN_PASSWORD=CHANGE_ME_strong_password

# Database (PostgreSQL recommended for production)
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/face_analytics
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://YOUR_SERVER_IP:5173

# Optional: restrict accepted Host headers. Leave empty for dev/LAN flexibility.
ALLOWED_HOSTS=
# Enable only when the backend is behind a trusted reverse proxy.
TRUST_PROXY_HEADERS=0

# HikCentral Professional OpenAPI. Create an OpenAPI application in HikCentral
# and use its AppKey/AppSecret; web console credentials are not OpenAPI keys.
HIKCENTRAL_URL=https://YOUR_HIKCENTRAL_HOST
HIKCENTRAL_AUTH_MODE=artemis
HIKCENTRAL_APP_KEY=
HIKCENTRAL_APP_SECRET=
HIKCENTRAL_VERIFY_TLS=1
HIKCENTRAL_TIMEOUT_SECONDS=15
HIKCENTRAL_TEST_PATH=/artemis/api/resource/v1/regions
HIKCENTRAL_PERSON_LIST_PATH=/artemis/api/resource/v1/person/personList

# Encode camera credentials in RTSP URLs. Disable only if a specific camera rejects encoded credentials.
RTSP_ENCODE_CREDENTIALS=1
CAMERA_OPEN_TIMEOUT_MS=5000
CAMERA_READ_TIMEOUT_MS=5000

# InsightFace (-1 = CPU, 0 = CUDA GPU)
INSIGHTFACE_CTX_ID=-1
INSIGHTFACE_MODEL=buffalo_l
INSIGHTFACE_DET_SIZE=640
FACE_WORKERS=2

# Media & security
IMAGES_DIR=media
MAX_UPLOAD_MB=10
# Readiness fails below this free-space threshold.
MEDIA_MIN_FREE_GB=2
# Optional media quota; 0 disables the quota check.
MEDIA_MAX_GB=0

# Optional: encrypt camera passwords stored in DB.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CAMERA_PASSWORD_KEY=CHANGE_ME_generate_a_fernet_key

# Hikvision alarm security. Configure an API key or an IP allowlist in production.
ALARM_API_KEY=
ALARM_ALLOWED_IPS=
ALARM_RATE_LIMIT=60
# Auto-register unknown cameras on first alarm (0=disabled, 1=enabled)
CAMERA_AUTO_REGISTER=0

# Rate limiting (memory fallback works for single-process dev; Redis is recommended for production)
RATE_LIMIT_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
WS_REDIS_CHANNEL=face-analytics:websocket
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=60
LOGIN_BLOCK_MINUTES=5

# Cleanup scheduler
LOW_QUALITY_RETENTION_DAYS=30
NORMAL_RETENTION_DAYS=180
CLEANUP_INTERVAL_HOURS=24
CLEANUP_DRY_RUN=0

# Backup scheduler
BACKUP_DIR=./backups
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_COUNT=14
BACKUP_INCLUDE_IMAGES=0
PG_DUMP_PATH=pg_dump
BACKUP_MIN_BYTES=1024

# Prometheus metrics. Loopback is always allowed. Use either a key or private
# network access for a monitoring container.
METRICS_API_KEY=
METRICS_ALLOW_PRIVATE=0

# ── Enterprise Features ────────────────────────────────────────────────────────

# SMTP (for scheduled reports and email alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=your_email@gmail.com
SMTP_TLS=1

# Redis (for caching and distributed rate limiting)
# REDIS_URL=redis://:your_password@localhost:6379/0
# REDIS_PASSWORD=your_redis_password

# Age/gender estimation (uses InsightFace genderage module)
# Set to 1 to enable (adds ~200ms processing time per face)
ENABLE_AGE_GENDER=0

# Refresh token expiry (days)
REFRESH_TOKEN_EXPIRE_DAYS=30
