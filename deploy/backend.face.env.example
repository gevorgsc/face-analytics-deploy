# Copy this file to backend/.env on the Ubuntu server.

APP_ENV=production
LOG_LEVEL=INFO
LOG_JSON=0

# Generate:
# python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_generate_a_random_64_char_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# First startup only. Change after first login.
DEFAULT_ADMIN_PASSWORD=CHANGE_ME_strong_admin_password

# Docker Compose overrides DATABASE_URL and REDIS_URL internally.
DATABASE_URL=postgresql+psycopg2://faceadmin:password@postgres:5432/face_analytics
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
REDIS_URL=redis://redis:6379/0
RATE_LIMIT_BACKEND=redis

# Public Ubuntu server address.
ALLOWED_ORIGINS=http://172.16.11.179
ALLOWED_HOSTS=172.16.11.179
TRUST_PROXY_HEADERS=1

COOKIE_SECURE=0
COOKIE_SAMESITE=lax
ENABLE_CSRF=1
ENABLE_API_DOCS=0
GLOBAL_RATE_LIMIT=200

# Face Analytics license only. Keep enabled for production.
LICENSE_ENFORCEMENT=1
LICENSE_PUBLIC_KEY_FILE=license_public_key.pem
LICENSE_FILE=runtime/license.json
LICENSE_INSTALLATION_ID_FILE=runtime/installation_id
LICENSE_SERVER_URL=
LICENSE_SERVER_TIMEOUT_SECONDS=15
LICENSE_SERVER_ALLOW_HTTP=0

# Generate:
# python3 - <<'PY'
# from cryptography.fernet import Fernet
# print(Fernet.generate_key().decode())
# PY
CAMERA_PASSWORD_KEY=CHANGE_ME_generate_a_fernet_key
RTSP_ENCODE_CREDENTIALS=1
CAMERA_OPEN_TIMEOUT_MS=5000
CAMERA_READ_TIMEOUT_MS=5000

# Linux HCNetSDK shared libraries are included; ONVIF/RTSP are also supported.
INSIGHTFACE_CTX_ID=-1
INSIGHTFACE_MODEL=buffalo_l
INSIGHTFACE_DET_SIZE=640
FACE_WORKERS=2
ENABLE_AGE_GENDER=0

IMAGES_DIR=media
MAX_UPLOAD_MB=10
MEDIA_URL_TTL_SECONDS=900
MEDIA_MIN_FREE_GB=2
MEDIA_MAX_GB=0

# Hikvision alarm receiver. Configure at least one protection method in production.
ALARM_API_KEY=CHANGE_ME_alarm_ingest_key
ALARM_ALLOWED_IPS=
ALARM_RATE_LIMIT=60
ALARM_OPEN_ACCESS=0
CAMERA_AUTO_REGISTER=0

LOW_QUALITY_RETENTION_DAYS=30
NORMAL_RETENTION_DAYS=180
CLEANUP_INTERVAL_HOURS=24
CLEANUP_DRY_RUN=0

BACKUP_DIR=./backups
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_COUNT=14
BACKUP_INCLUDE_IMAGES=0
PG_DUMP_PATH=pg_dump
BACKUP_MIN_BYTES=1024

METRICS_API_KEY=
METRICS_ALLOW_PRIVATE=0
